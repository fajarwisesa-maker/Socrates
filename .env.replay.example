# SIAGA laptop mode "replay" (offline fallback): everything runs on the laptop from the
# golden recording. No network to Bedrock, SAP AI Core or BTP. No secrets in this file.
# `make use-replay` copies it to .env (it makes .env.replay from this file if missing).
SIAGA_MODE=replay
LLM_PROVIDER=replay
REPLAY=1
# the v2 recording (multi-agent + delay model + PII check); RPT answers from rpt.jsonl there
REPLAY_PATH=data/golden/v2/llm.jsonl
REPLAY_SPEED=1.0
# v2 flags live here because SSM is not reachable offline
FLAGS_SOURCE=env
SECRETS_SOURCE=env
ORCHESTRATION=multi
DELAY_MODEL=rpt
SAP_MOCK_ON_BTP=0
PII_MASKING=local
JOULE_APPROVALS=0
# local backends and services
CASE_STORE=sqlite
AUDIT_BACKEND=local
KB_BACKEND=local
POLICY_BACKEND=local
SOLVER_BACKEND=inprocess
SAP_MOCK_URL=http://127.0.0.1:8001
CASE_API_URL=http://127.0.0.1:8000
