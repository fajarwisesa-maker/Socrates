# SIAGA laptop mode "local" (Demo Day default, "laptop live"): the whole stack runs on this
# laptop (make dev) with local stores, and calls the live services: the LLM, the mock
# S/4HANA on SAP BTP and SAP RPT-1.6 on AI Core. Flags come from this file.
# Make the real file with scripts/fill-env.sh, then `make use-local`. Never commit .env.local.
SIAGA_MODE=local
# Bedrock, with Claude via SAP AI Core as the fallback when Bedrock refuses a case at its
# start (account or throttling error). While Bedrock is blocked on the account, use
# LLM_PROVIDER=sap_genai (fill-env.sh asks).
LLM_PROVIDER=bedrock
LLM_FALLBACK=sap_genai
REPLAY=0
AWS_PROFILE=siaga
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=<set-me>
SAP_GENAI_MODEL=anthropic--claude-4.6-sonnet
# SAP AI Core service key (RPT-1.6 and Claude); fill-env.sh reads the service key JSON
AICORE_AUTH_URL=<set-me>
AICORE_CLIENT_ID=<set-me>
AICORE_CLIENT_SECRET=<set-me>
AICORE_API_URL=<set-me>
AICORE_RESOURCE_GROUP=default
AICORE_RPT_DEPLOYMENT_ID=<set-me>
# the mock S/4HANA on BTP (docs/btp-deploy.md)
SAP_MOCK_ON_BTP=1
SAP_MOCK_BTP_URL=<set-me>
SAP_MOCK_API_KEY=<set-me>
# v2 flags (no SSM in this mode)
FLAGS_SOURCE=env
SECRETS_SOURCE=env
ORCHESTRATION=multi
DELAY_MODEL=rpt
PII_MASKING=local
JOULE_APPROVALS=0
# local backends and services
CASE_STORE=sqlite
AUDIT_BACKEND=local
KB_BACKEND=local
POLICY_BACKEND=local
SOLVER_BACKEND=inprocess
SAP_MOCK_URL=http://127.0.0.1:8001
CASE_API_URL=http://127.0.0.1:8000
# `make record-golden` in this mode writes the v2 recording that `make use-replay` plays
REPLAY_PATH=data/golden/v2/llm.jsonl
# WhatsApp inbound (option A, off by default): a message to the team's WhatsApp test number
# opens a case. Fill with scripts/fill-whatsapp.sh; run `make whatsapp` and `make tunnel`
# next to `make dev` (docs/whatsapp-inbound.md).
WHATSAPP_INBOUND=0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_SENDERS=
