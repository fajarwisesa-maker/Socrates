# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# sap_genai (Claude on SAP AI Core, uses the AICORE_* values below) | fake | replay
LLM_PROVIDER=sap_genai
# SAP_GENAI_MODEL=anthropic--claude-4.6-sonnet   # deployment found in AICORE_RESOURCE_GROUP
# SAP_GENAI_DEPLOYMENT_ID=                       # optional: skip the lookup
# AWS is only used by the optional S3 audit trail and Lambda solver (docs/aws-setup.md).
AWS_REGION=ap-southeast-1
# AWS credentials for those: a named profile from ~/.aws (aws configure / aws sso login).
# AWS_* lines in this file are passed to boto3 (a variable set in your shell wins).
# AWS_PROFILE=siaga
# 1 = run the whole system on the recorded golden run (no network to any model). Phase 6.
REPLAY=0
REPLAY_PATH=data/golden/llm.jsonl
REPLAY_SPEED=1.0           # 1.0 = recorded model latency, 0 = instant
# Record every LLM call of a run to this JSONL (used to build the Phase 6 golden run).
# LLM_RECORD_PATH=data/golden/llm.jsonl
# Demo/test aid: N visible throttling retries on each case's first model call, or "exhaust".
# LLM_SIMULATE_THROTTLE=2
# Brief asks for temperature 0. If the model rejects it, the provider drops it once.
# Set "off" to never send it.
LLM_TEMPERATURE=0

# --- Backends: local (Phases 1-6) vs AWS (Phase 7) ---
CASE_STORE=sqlite          # sqlite | dynamodb
AUDIT_BACKEND=local        # local | s3 (+ AUDIT_S3_BUCKET; make aws-setup, docs/aws-setup.md)
# AUDIT_S3_BUCKET=  AUDIT_S3_PREFIX=audit/  AUDIT_RETENTION_DAYS=1
KB_BACKEND=local           # local only (BM25 over data/demo/precedents)
POLICY_BACKEND=local       # local only (Cedar via cedarpy)
SOLVER_BACKEND=inprocess   # inprocess | http (SOLVER_URL) | lambda (SOLVER_LAMBDA_NAME)
# SOLVER_LAMBDA_NAME=siaga-solver  SOLVER_LAMBDA_FALLBACK=1   (1 = solve locally if Lambda fails)

# --- Local services ---
SAP_MOCK_URL=http://127.0.0.1:8001
SOLVER_URL=http://127.0.0.1:8002
CASE_API_URL=http://127.0.0.1:8000
SQLITE_PATH=var/siaga.db
SAP_DB_PATH=var/sap_mock.db
AUDIT_DIR=var/audit

# --- SIAGA v2 flags (docs/v2-flags.md). All off = v1 behaviour. ---
ORCHESTRATION=single       # single | multi (specialist Strands agents)
SAP_MOCK_ON_BTP=0          # step 1: 1 = the mock S/4HANA on BTP (docs/btp-deploy.md)
# SAP_MOCK_BTP_URL=https://<route of siaga-sap-mock>
DELAY_MODEL=signal         # step 3: signal | rpt (SAP RPT-1.6 on AI Core) | fake (offline stand-in)
# RPT_TIMEOUT_SECONDS=5
JOULE_APPROVALS=0          # step 4 (not built; ignored)
PII_MASKING=off            # step 5: off | local (mask phones, e-mails, names before any model call)
WHATSAPP_INBOUND=0         # 1 = a WhatsApp message opens a case (docs/whatsapp-inbound.md)
# WHATSAPP_VERIFY_TOKEN= / WHATSAPP_APP_SECRET= / WHATSAPP_ALLOWED_SENDERS=   (fill-whatsapp.sh)
WHATSAPP_NOTIFY=0          # 1 = reply once to the sender with the case outcome (option B)
# WHATSAPP_ACCESS_TOKEN= / WHATSAPP_PHONE_NUMBER_ID=   (fill-whatsapp.sh)
# WHATSAPP_GRAPH_VERSION=26.0
WHATSAPP_PROVIDER=meta     # or twilio: Twilio's WhatsApp sandbox instead of a Meta app
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   (fill-twilio.sh)
# TWILIO_WEBHOOK_URL=      # only if the tunnel hides the public URL (signature check)

# --- Where configuration comes from (docs/connections.md). Laptop: `make use-local|use-replay|
# use-v1` writes the whole .env from .env.<mode> instead of this file. ---
# SIAGA_MODE=local         # local | aws | replay | v1 (set by make use-*; drives preflight)
FLAGS_SOURCE=env           # env | ssm (/siaga/flags/*, read again at the start of each case)
SECRETS_SOURCE=env         # env | aws (Secrets Manager SAP_SECRET_ID, read once at start)
# SAP_SECRET_ID=siaga/sap
# CASE_API_KEY=            # when set, the Case API requires X-API-Key (dashboard adds it)

# --- SAP (v2). Set in the environment settings or here; never commit values. ---
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_API_URL=
AICORE_RESOURCE_GROUP=default
AICORE_RPT_DEPLOYMENT_ID=
SAP_MOCK_API_KEY=

# --- Agent loop limits ---
MAX_TOOL_CALLS=20
MAX_REPLANS=2
VERIFY_DELAY_SECONDS=60
