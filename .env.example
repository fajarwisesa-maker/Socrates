# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# bedrock | fake | replay
LLM_PROVIDER=bedrock
# Required for LLM_PROVIDER=bedrock. No default on purpose; pick one via `make aws-check`.
# May be a foundation model ID or a cross-region inference profile ID (e.g. apac.* / global.*).
BEDROCK_MODEL_ID=
AWS_REGION=ap-southeast-1
# AWS credentials come from the normal boto3 chain (AWS_PROFILE, env keys, SSO, ...).
# AWS_PROFILE=siaga
# 1 = run the whole system on the recorded golden run (no network to Bedrock). Phase 6.
REPLAY=0
REPLAY_PATH=data/golden/llm.jsonl
REPLAY_SPEED=1.0           # 1.0 = recorded model latency, 0 = instant
# Record every LLM call of a run to this JSONL (used to build the Phase 6 golden run).
# LLM_RECORD_PATH=data/golden/llm.jsonl
# Brief asks for temperature 0. Current Claude models reject non-default sampling; the
# Bedrock provider then drops it automatically. Set "off" to never send it.
LLM_TEMPERATURE=0

# --- Backends: local (Phases 1-6) vs AWS (Phase 7) ---
CASE_STORE=sqlite          # sqlite | dynamodb
AUDIT_BACKEND=local        # local | s3
KB_BACKEND=local           # local | bedrock
POLICY_BACKEND=local       # local | agentcore
SOLVER_BACKEND=inprocess   # inprocess | http (SOLVER_URL) | lambda

# --- Local services ---
SAP_MOCK_URL=http://127.0.0.1:8001
SOLVER_URL=http://127.0.0.1:8002
CASE_API_URL=http://127.0.0.1:8000
SQLITE_PATH=var/siaga.db
SAP_DB_PATH=var/sap_mock.db
AUDIT_DIR=var/audit

# --- Agent loop limits ---
MAX_TOOL_CALLS=20
MAX_REPLANS=2
VERIFY_DELAY_SECONDS=60
