# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# bedrock | fake | replay
LLM_PROVIDER=bedrock
# Required for LLM_PROVIDER=bedrock. No default on purpose; pick one via `make aws-check`.
# May be a foundation model ID or a cross-region inference profile ID (e.g. apac.* / global.*).
BEDROCK_MODEL_ID=
AWS_REGION=ap-southeast-1
# AWS credentials: use ONE of the options below. AWS_* lines in this file are passed to
# boto3 (a variable already set in your shell wins). Never commit .env.
#  a) a named profile from ~/.aws (aws configure / aws sso login):
# AWS_PROFILE=siaga
#  b) access keys of an IAM user/role with bedrock:InvokeModel (+ ListFoundationModels):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary credentials
#  c) an Amazon Bedrock API key (Bedrock console > API keys). Enough for the agent's model
#     calls; `make aws-check` also calls STS and needs a) or b).
# AWS_BEARER_TOKEN_BEDROCK=
# 1 = run the whole system on the recorded golden run (no network to Bedrock). Phase 6.
REPLAY=0
REPLAY_PATH=data/golden/llm.jsonl
REPLAY_SPEED=1.0           # 1.0 = recorded model latency, 0 = instant
# Record every LLM call of a run to this JSONL (used to build the Phase 6 golden run).
# LLM_RECORD_PATH=data/golden/llm.jsonl
# Demo/test aid: N visible throttling retries on each case's first model call, or "exhaust".
# LLM_SIMULATE_THROTTLE=2
# Brief asks for temperature 0. Current Claude models reject non-default sampling; the
# Bedrock provider then drops it automatically. Set "off" to never send it.
LLM_TEMPERATURE=0

# --- Backends: local (Phases 1-6) vs AWS (Phase 7) ---
CASE_STORE=sqlite          # sqlite | dynamodb
AUDIT_BACKEND=local        # local | s3
KB_BACKEND=local           # local | bedrock
POLICY_BACKEND=local       # local | agentcore
SOLVER_BACKEND=inprocess   # inprocess | http (SOLVER_URL) | lambda

# --- Local services ---
SAP_MOCK_URL=http://127.0.0.1:8001
SOLVER_URL=http://127.0.0.1:8002
CASE_API_URL=http://127.0.0.1:8000
SQLITE_PATH=var/siaga.db
SAP_DB_PATH=var/sap_mock.db
AUDIT_DIR=var/audit

# --- SIAGA v2 flags (docs/v2-flags.md). All off = v1 behaviour. ---
ORCHESTRATION=single       # single | multi (specialist Strands agents)
SAP_MOCK_ON_BTP=0          # step 1: 1 = the mock S/4HANA on BTP (docs/btp-deploy.md)
# SAP_MOCK_BTP_URL=https://<route of siaga-sap-mock>
DELAY_MODEL=signal         # step 3: signal | rpt (SAP RPT-1.6 on AI Core) | fake (offline stand-in)
# RPT_TIMEOUT_SECONDS=5
# JOULE_APPROVALS=0        # step 4
PII_MASKING=off            # step 5: off | local (mask phones, e-mails, names before any model call)

# --- SAP (v2). Set in the environment settings or here; never commit values. ---
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_API_URL=
AICORE_RESOURCE_GROUP=default
AICORE_RPT_DEPLOYMENT_ID=
SAP_MOCK_API_KEY=
CASE_API_KEY=

# --- Agent loop limits ---
MAX_TOOL_CALLS=20
MAX_REPLANS=2
VERIFY_DELAY_SECONDS=60
