# SIAGA laptop mode "v1" (oldest fallback): v1 behaviour, every v2 flag off, running
# locally (mock SAP, Case API, dashboard on this laptop) with Claude on SAP AI Core.
# Make the real file with scripts/fill-env.sh, then `make use-v1`. Never commit .env.v1.
SIAGA_MODE=v1
LLM_PROVIDER=sap_genai
REPLAY=0
SAP_GENAI_MODEL=anthropic--claude-4.6-sonnet
AICORE_AUTH_URL=<set-me>
AICORE_CLIENT_ID=<set-me>
AICORE_CLIENT_SECRET=<set-me>
AICORE_API_URL=<set-me>
AICORE_RESOURCE_GROUP=default
FLAGS_SOURCE=env
SECRETS_SOURCE=env
ORCHESTRATION=single
DELAY_MODEL=signal
SAP_MOCK_ON_BTP=0
PII_MASKING=off
JOULE_APPROVALS=0
CASE_STORE=sqlite
AUDIT_BACKEND=local
KB_BACKEND=local
POLICY_BACKEND=local
SOLVER_BACKEND=inprocess
SAP_MOCK_URL=http://127.0.0.1:8001
CASE_API_URL=http://127.0.0.1:8000
