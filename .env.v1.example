# SIAGA laptop mode "v1" (oldest fallback): v1 behaviour, every v2 flag off, running
# locally (mock SAP, Case API, dashboard on this laptop) against Bedrock.
# Make the real file with scripts/fill-env.sh, then `make use-v1`. Never commit .env.v1.
SIAGA_MODE=v1
LLM_PROVIDER=bedrock
REPLAY=0
AWS_PROFILE=siaga
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=<set-me>
FLAGS_SOURCE=env
SECRETS_SOURCE=env
ORCHESTRATION=single
DELAY_MODEL=signal
SAP_MOCK_ON_BTP=0
PII_MASKING=off
JOULE_APPROVALS=0
CASE_STORE=sqlite
AUDIT_BACKEND=local
KB_BACKEND=local
POLICY_BACKEND=local
SOLVER_BACKEND=inprocess
SAP_MOCK_URL=http://127.0.0.1:8001
CASE_API_URL=http://127.0.0.1:8000
