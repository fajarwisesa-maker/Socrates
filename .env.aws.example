# SIAGA laptop mode "aws" (Demo Day default): the dashboard, `make preflight` and
# `make rehearse` talk to the deployed Case API. The agent, its secrets (Secrets Manager
# siaga/sap) and its flags (SSM /siaga/flags/*) live in AWS, not here.
# Make the real file with scripts/fill-env.sh, then `make use-aws`. Never commit .env.aws.
SIAGA_MODE=aws
# Laptop AWS access: a named profile only (aws configure / aws sso login), never keys here.
AWS_PROFILE=siaga
AWS_REGION=ap-southeast-1
# for make preflight and make record-golden from the laptop
BEDROCK_MODEL_ID=<set-me>
# the deployed stack's CaseApiUrl output (not a secret)
CASE_API_URL=<set-me>
# sent as X-API-Key by the dashboard proxy, preflight and rehearse; same value as in siaga/sap
CASE_API_KEY=<set-me>
# preflight compares the SSM flags with `make flags-v2`
FLAGS_SOURCE=ssm
